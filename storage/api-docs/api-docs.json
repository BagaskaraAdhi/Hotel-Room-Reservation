{
    "openapi": "3.0.0",
    "info": {
        "title": "Hotel Room Reservation",
        "version": "1.0"
    },

    "paths": {
        "/api/register": {
            "post": {
                "tags": ["Auth"],
                "summary": "Registrasi akun baru",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "phone_number",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "nafii"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": ["admin", "user"],
                                        "example": "user"
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "085233361858"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "nafi19@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "nafi1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User berhasil diregistrasi"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": ["Auth"],
                "summary": "Login dan dapatkan token JWT (berlaku 2 jam)",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["email", "password"],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "nafi19@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "nafi1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil"
                    },
                    "401": {
                        "description": "Kredensial salah"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": ["Auth"],
                "summary": "Logout user (hapus token saat ini)",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logout berhasil"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/me": {
            "get": {
                "tags": ["Auth"],
                "summary": "Get data user yang sedang login",
                "operationId": "8367feff40ba10e43187792cad3132c1",
                "responses": {
                    "200": {
                        "description": "User data berhasil ditampilkan"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/payments": {
            "get": {
                "tags": ["Payments"],
                "summary": "Menampilkan semua data pembayaran",
                "operationId": "c7732b5197593b9216465b4c89957bdb",
                "responses": {
                    "200": {
                        "description": "Daftar pembayaran berhasil ditampilkan"
                    }
                }
            },
            "post": {
                "tags": ["Payments"],
                "summary": "Membuat pembayaran dan mendapatkan Snap Token",
                "operationId": "4d18b974f35e5bcc5443060b26a3e053",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": ["amount"],
                                "properties": {
                                    "amount": {
                                        "type": "number",
                                        "example": 100000
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "credit_card"
                                    },
                                    "customer_name": {
                                        "type": "string",
                                        "example": "Mr. Nafi"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Snap token berhasil dibuat"
                    },
                    "500": {
                        "description": "Gagal membuat pembayaran"
                    }
                }
            }
        },
        "/api/payments/{id}": {
            "get": {
                "tags": ["Payments"],
                "summary": "Menampilkan detail pembayaran berdasarkan ID",
                "operationId": "09b5ced23a60fac5708da0d1d5f98ae2",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID pembayaran",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detail pembayaran ditemukan"
                    },
                    "404": {
                        "description": "Pembayaran tidak ditemukan"
                    }
                }
            },
            "put": {
                "tags": ["Payments"],
                "summary": "Update data pembayaran",
                "operationId": "c422013925aafb7d1e2bed4a12edfa84",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID pembayaran",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "example": "Paid"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "credit_card"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Pembayaran berhasil diupdate"
                    },
                    "404": {
                        "description": "Pembayaran tidak ditemukan"
                    }
                }
            },
            "delete": {
                "tags": ["Payments"],
                "summary": "Menghapus pembayaran berdasarkan ID",
                "operationId": "18cbb5ddf4ff49fb0a0d914555029a43",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID pembayaran",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pembayaran berhasil dihapus"
                    }
                }
            }
        },
        "/api/payments/callback": {
            "post": {
                "tags": ["Payments"],
                "summary": "Callback dari Midtrans untuk update status pembayaran",
                "operationId": "418c20a88301c4a0f1481c3bc1f5ad98",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "signature_key",
                                    "order_id",
                                    "status_code",
                                    "gross_amount",
                                    "transaction_status"
                                ],
                                "properties": {
                                    "signature_key": {
                                        "type": "string"
                                    },
                                    "order_id": {
                                        "type": "string"
                                    },
                                    "status_code": {
                                        "type": "string"
                                    },
                                    "gross_amount": {
                                        "type": "string"
                                    },
                                    "transaction_status": {
                                        "type": "string",
                                        "example": "settlement"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status pembayaran diperbarui"
                    },
                    "403": {
                        "description": "Signature tidak valid"
                    },
                    "404": {
                        "description": "Pembayaran tidak ditemukan"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "API untuk autentikasi user dan admin"
        },
        {
            "name": "Payments",
            "description": "API untuk mengelola pembayaran menggunakan Midtrans"
        }
    ]
}
