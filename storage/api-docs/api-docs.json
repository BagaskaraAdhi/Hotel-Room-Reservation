        "/midtrans/callback": {
            "post": {
                "tags": [
                    "Midtrans Webhook"
                ],
                "summary": "Callback Notifikasi Pembayaran Midtrans",
                "description": "ENDPOINT INI BUKAN UNTUK DIGUNAKAN OLEH FRONTEND. Endpoint ini menerima notifikasi (webhook) dari server Midtrans untuk update status pembayaran secara otomatis.",
                "operationId": "70804a1de6576a2b99396d786d75a2ae",
                "requestBody": {
                    "description": "Payload yang dikirim oleh server Midtrans.",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "transaction_time": {
                                        "type": "string",
                                        "example": "2025-06-18 09:10:00"
                                    },
                                    "transaction_status": {
                                        "type": "string",
                                        "example": "settlement"
                                    },
                                    "transaction_id": {
                                        "type": "string",
                                        "example": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                    },
                                    "status_message": {
                                        "type": "string",
                                        "example": "midtrans payment notification"
                                    },
                                    "status_code": {
                                        "type": "string",
                                        "example": "200"
                                    },
                                    "signature_key": {
                                        "type": "string"
                                    },
                                    "payment_type": {
                                        "type": "string",
                                        "example": "gopay"
                                    },
                                    "order_id": {
                                        "type": "string",
                                        "example": "PAY-1-1749875460"
                                    },
                                    "merchant_id": {
                                        "type": "string"
                                    },
                                    "gross_amount": {
                                        "type": "string",
                                        "example": "550000.00"
                                    },
                                    "fraud_status": {
                                        "type": "string",
                                        "example": "accept"
                                    },
                                    "currency": {
                                        "type": "string",
                                        "example": "IDR"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Notifikasi berhasil diproses"
                    },
                    "404": {
                        "description": "Order ID tidak ditemukan"
                    }
                }
            }
        },
