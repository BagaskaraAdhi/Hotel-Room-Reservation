{
    "openapi": "3.0.0",
    "info": {
        "title": "Hotel Room Reservation",
        "description": "API Documentation for Hotel Room Reservation",
        "version": "1.0.0"
    },
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register user baru",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "email",
                                    "password",
                                    "phone_number"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "john_doe"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "admin",
                                            "user"
                                        ],
                                        "example": "user"
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "081234567890"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "john@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Berhasil register"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login user",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "john@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Berhasil login"
                    },
                    "422": {
                        "description": "validation failed"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout user",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Berhasil logout"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Ambil data user yang sedang login",
                "operationId": "8367feff40ba10e43187792cad3132c1",
                "responses": {
                    "200": {
                        "description": "Data user saat ini"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/room": {
            "get": {
                "tags": [
                    "Room"
                ],
                "summary": "Ambil daftar semua room",
                "operationId": "1758cfa0a4f31164f32a8c2192f97d86",
                "responses": {
                    "200": {
                        "description": "Berhasil ambil data"
                    },
                    "500": {
                        "description": "Gagal ambil data"
                    }
                }
            },
            "post": {
                "tags": [
                    "Room"
                ],
                "summary": "Buat room baru",
                "operationId": "9be38be1eed9b9d7e62fd45fca294b7c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "RoomNumber",
                                    "RoomType",
                                    "Capacity",
                                    "Status",
                                    "defaultPrice",
                                    "defaultExtraBedPrice"
                                ],
                                "properties": {
                                    "RoomNumber": {
                                        "type": "string",
                                        "example": "A101"
                                    },
                                    "RoomType": {
                                        "type": "string",
                                        "enum": [
                                            "single",
                                            "double",
                                            "twin",
                                            "family",
                                            "suite"
                                        ]
                                    },
                                    "Capacity": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "Status": {
                                        "type": "string",
                                        "enum": [
                                            "ready",
                                            "maintenance"
                                        ]
                                    },
                                    "defaultPrice": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 500000
                                    },
                                    "defaultExtraBedPrice": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 100000
                                    },
                                    "discount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 10
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Room berhasil dibuat"
                    },
                    "500": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/api/room/{id}": {
            "get": {
                "tags": [
                    "Room"
                ],
                "summary": "Ambil detail room berdasarkan ID",
                "operationId": "c45e99f9ccf62d45114462c46ea5036a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Berhasil ambil data"
                    },
                    "404": {
                        "description": "Room tidak ditemukan"
                    }
                }
            },
            "put": {
                "tags": [
                    "Room"
                ],
                "summary": "Update data room",
                "operationId": "096109bd729e9ee91d620d1b883d87df",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "RoomNumber": {
                                        "type": "string",
                                        "example": "A101"
                                    },
                                    "RoomType": {
                                        "type": "string",
                                        "enum": [
                                            "single",
                                            "double",
                                            "twin",
                                            "family",
                                            "suite"
                                        ]
                                    },
                                    "Capacity": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "Status": {
                                        "type": "string",
                                        "enum": [
                                            "ready",
                                            "maintenance"
                                        ]
                                    },
                                    "imageShowRoom": {
                                        "type": "file"
                                    },
                                    "defaultPrice": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 500000
                                    },
                                    "defaultExtraBedPrice": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 100000
                                    },
                                    "discount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 10
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Room berhasil diupdate"
                    },
                    "404": {
                        "description": "Room tidak ditemukan"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Room"
                ],
                "summary": "Hapus room",
                "operationId": "ba010fe020114b40d872de5e7913a8d5",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Room berhasil dihapus"
                    },
                    "404": {
                        "description": "Room tidak ditemukan"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Room",
            "description": "Room"
        }
    ]
}